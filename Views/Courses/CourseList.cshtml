@model IEnumerable<Wikimedia.Models.Course>
@{
    var yearsList = ((List<int>)Session["CourseYearsList"]).OrderByDescending(i => i);
    string search = ViewBag.SearchString ?? "";
    bool searching = ViewBag.Search ?? false;

    Func<string, string> highlight = (text) =>
    {
        if (!searching || string.IsNullOrEmpty(search))
            return text;

        string lower = text.ToLower();
        string key = search.ToLower();
        int index = lower.IndexOf(key);
        if(index < 0) return text;

        return text.Substring(0, index) + "<span class='highlight'>" + text.Substring(index, key.Length) + "</span>" + text.Substring(index + key.Length);
    };
}
<div class="courseListContainer">
    @for(int session = 1; session <= 6; session++)
    {
        var group = Model.Where(c => c.Session == session.ToString()).ToList();
        if (!group.Any())
        {
            continue;
        }
        <details open class="sessionGroup">
            <summary>Session @session</summary>
            <ul>
                @foreach(var course in group)
                {
                    string caption = "[" + course.Session + "] " + course.Code + " " + course.Title;
                    string html = highlight(caption);

                    <li>
                        <a href="~/Views/Courses/CourseDetails.cshtml"/@course.Id class="courseLink">
                            @Html.Raw(html)
                        </a>
                    </li>
                }
            </ul>
        </details>
    }
</div>
<footer>
    Session courante: @NextSession.Caption
</footer>