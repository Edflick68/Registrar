@Model Course
@{
    ViewBag.PageTitle = "Course - Modification";
    string session = NextSession.Caption;
}

<details open>
    <summary>Informations</summary>
    <div class="formGrid">
        <div class="formItem">
            <label>Session</label>
            @Html.TextBoxFor(m => m.Session, new { @class = "form-control"})
        </div>
        <div class="formItem">
            <label>Sigle</label>
            @Html.TextBoxFor(m => m.Code, new { @class = "form-control"})
        </div>
        <div class="formItem">
            <label>Titre</label>
            @Html.TextBoxFor(m => m.Title, new { @class = "form-control"})
        </div>
    </div>
</details>
<details open>
    <summary>Inscriptions: </summary>
    @Helper.SelectionLists(
        "selectedStudentsId",
        (SelectList)ViewBag.Registrations,
        (SelectList)ViewBag.Students)
</details>
<input type="submit" id="submit" style="display: none"/>