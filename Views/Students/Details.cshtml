@model Wikimedia.Models.Student
@{
    ViewBag.PageTitle = "Étudiant - Détails";
    string session = NextSession.Caption;
    var grouped = ViewBag.GroupedRegistrations as Dictionary<int, List<Wikimedia.Models.Registration>>;
}
<div class="studentDetailsContainer">
    <div class="headerSection">
        <h2><i class="fa fa-user-graduate"></i>@Model.FullName</h2>
        <div class="studentInfo">
            <p><b>@Model.Code</b></p>
            <p><i class="fa fa-phone"></i>@Model.Phone</p>
            <p><i class="fa fa-envelope"></i>@Model.Email</p>
            <p><i class="fa fa-cake"></i>@Model.BirthDate.ToString("dd MMMM yyyy")</p>
        </div>
    </div>
    <div class="inscriptionSection">
        <h3><i class="fa fa-book"></i>Inscriptions</h3>
        @foreach(var year in grouped.Keys.OrderByDescending(y => y))
            {
                <details open>
                    <summary>@year</summary>
                    <ul class="courseList">
                        @foreach(var reg in grouped[year])
                        {
                            <li>
                                <a href="@Url.Action("Details", "Courses", new { id = reg.Course.Id })">
                                    @reg.Course.Code - @reg.Course.Title
                                </a>
                            </li>
                        }
                    </ul>
                </details>
            }
    </div>
</div>
