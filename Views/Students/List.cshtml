@model IEnumerable<Wikimedia.Models.Student>

@{
    ViewBag.Title = "Vue liste des étudiants";
    ViewBag.PageTitle = "Étudiants";
    string search = ViewBag.SearchString as string ?? "";
    string currentSessionCaption = NextSession.ShortCaption;
}


<div class="row">
    <div class="col-md-12">

        @foreach (var cohortGroup in Model.GroupBy(s => s.Year).OrderByDescending(g => g.Key))
        {
            <details class="yearGroup" open>
                <summary>Cohorte @cohortGroup.Key</summary>
                <div>
                    <ul class="list-group">
                        @foreach (var student in cohortGroup.OrderBy(s => s.LastName).ThenBy(s => s.FirstName))
                        {
                            <li class="list-group-item">
                                <a href="@Url.Action("Details", new { id = student.Id })"
                                   style="text-decoration: none; color: inherit; display: block;">
                                    <span class="studentCode">@student.Code</span>
                                    @Html.Raw(Highlight(
                                        " " + student.FirstName + " " + student.LastName,
                                        ViewBag.SearchString as string ?? ""
                                    ))
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </details>
        }
        
    </div>

</div>
<div class="row">
    <div class="col-md-12">

        <a href="/Students/SetYear" style="text-decoration: none; color: inherit; display: block; padding: 12px;">
            Session courante :
            <span style="color: #0066cc;">@currentSessionCaption</span>
            <i class="fa fa-caret-down" style="margin-left: 8px;"></i>
        </a>
    </div>
</div>
    @helper Highlight(string text, string searchTerm)
    {
        if (string.IsNullOrEmpty(searchTerm) || string.IsNullOrEmpty(text))
        {
            <text>@text</text>
            return;
        }

        var highlighted = System.Text.RegularExpressions.Regex.Replace(
            text,
            System.Text.RegularExpressions.Regex.Escape(searchTerm),
            match => "<span class=\"highlight\">" + match.Value + "</span>",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase
        );

        <text>@Html.Raw(highlighted)</text>
    }
