@model IEnumerable<Wikimedia.Models.Teacher>
@{
    var yearsList = (Session["TeachersYearsList"] as List<int>) ?? new List<int>();
    string search = ViewBag.SearchString ?? "";
    bool searching = ViewBag.Search ?? false;

    Func<string, string> highlight = (text) =>
    {
        if (!searching || string.IsNullOrEmpty(search))
            return text;
        string lower = text.ToLower();
        string key = search.ToLower();
        int index = lower.IndexOf(key);
        if (index < 0) return text;
        return text.Substring(0, index) +
        "<span class='highlight'>" + text.Substring(index, key.Length) + "</span>" + text.Substring(index + key.Length);
    };
}
<div class="teachersContainer">
    @foreach (var teacher in Model.OrderByDescending(t => t.LastName))
    {
        string caption = teacher.LastName + " " + teacher.FirstName;
        string html = highlight(caption);

        <div class="TeacherListLayout">
            <a href="@Url.Action("Details", "Teachers", new {id = teacher.Id})">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <img src="@teacher.Avatar" alt="@teacher.FullName" class="teacherAvatar" />
                    <span class="teacherCode">@teacher.Code</span>
                    <div class="tName">@Html.Raw(html)</div>
                </div>
            </a>
        </div>
    }
</div>
<footer>
    Session courante: @NextSession.Caption
</footer>