@model IEnumerable<Wikimedia.Models.Teacher>
@{
    var yearsList = ((List<int>)Session["CourseYearsList"]).OrderByDescending(i => i);
}
@foreach (int year in yearsList)
{
    var courses = Model.Where(s => s.Year == year);
    if (courses.Count() > 0)
    {
        <details id="teacher_details_@year">
            <summary>Cohorte @year </summary>
            @foreach (var item in courses)
            {
                <div class="TeacherListLayout">
                    <a href=" @Url.Action( "Details" , new { id = item .Id })">
                        <div style="display : flex">
                            <span class="teacherCode"> @item.Code </span>
                            <div class="tName"> @item.LastName @item.FirstName </div>
                        </div>
                    </a>
                </div>
            }
        </details>
    }
}